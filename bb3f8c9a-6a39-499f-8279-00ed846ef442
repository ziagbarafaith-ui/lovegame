@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');
:root{--bg:#171225;--panel:#211a32;--panel2:#2a2140;--text:#fff8f5;--muted:#b8adc8;--pink:#ff6e9c;--pink2:#ff9fba;--line:#ffffff16;--green:#78e0b0}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 15% 5%,#432344 0,transparent 38%),radial-gradient(ellipse at 90% 85%,#30224c 0,transparent 35%),var(--bg);color:var(--text);font-family:'DM Sans',sans-serif}
button,input{font:inherit}.shell{width:min(1120px,calc(100% - 40px));margin:auto;min-height:100vh;display:flex;flex-direction:column}.topbar{height:82px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:22px;font-weight:700;color:var(--text);text-decoration:none;letter-spacing:-.7px}.brand-heart{color:var(--pink);font-size:28px;margin-right:7px}.top-note,.small-note,footer{color:var(--muted);font-size:12px}
.panel{background:linear-gradient(145deg,#2a213b,#211a31);border:1px solid var(--line);border-radius:22px;box-shadow:0 18px 55px #08051045}
.welcome{width:min(720px,100%);margin:55px auto 40px;padding:clamp(28px,6vw,64px);text-align:center}.eyebrow{font-size:10px;font-weight:700;letter-spacing:2px;color:var(--pink2)}h1{font:700 clamp(42px,7vw,68px)/1.06 'Playfair Display',serif;letter-spacing:-1.8px;margin:18px 0}h1 span{color:var(--pink2)}.intro{max-width:440px;margin:0 auto 30px;color:var(--muted);line-height:1.7;font-size:14px}.join-grid{display:grid;gap:12px;max-width:430px;margin:auto}.btn{border:0;border-radius:12px;padding:14px 18px;font-weight:700;cursor:pointer;transition:transform .15s,opacity .15s}.btn:hover:not(:disabled){transform:translateY(-2px)}.btn:disabled{opacity:.4;cursor:not-allowed}.btn-primary{background:linear-gradient(100deg,var(--pink),#ff8eaa);color:#35172a}.btn-primary span{float:right;font-size:18px}.join-box{display:flex;gap:8px}.join-box input{min-width:0;flex:1;background:#ffffff0b;border:1px solid var(--line);border-radius:12px;padding:13px;color:white;text-transform:uppercase;letter-spacing:3px;text-align:center;outline:none}.join-box input:focus{border-color:var(--pink)}.btn-secondary{background:#ffffff12;color:white;border:1px solid var(--line)}.status{font-size:11px;color:var(--muted);line-height:1.6;min-height:18px}.feature-row{display:flex;justify-content:center;gap:22px;flex-wrap:wrap;margin-top:30px;color:#e4d7e8;font-size:11px}.hidden{display:none!important}
.game{margin:20px 0 35px}.roombar{padding:16px 22px;display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.roombar strong{display:block;font-size:22px;letter-spacing:5px;margin-top:5px}.copy-btn{border:1px solid var(--line);background:#ffffff0b;color:var(--text);border-radius:10px;padding:10px 13px;font-size:11px;cursor:pointer}.game-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(270px,.85fr);gap:16px}.play-area{padding:clamp(18px,3vw,30px)}.game-heading{display:flex;justify-content:space-between;gap:12px;align-items:center}h2{font:600 27px 'Playfair Display',serif;margin:7px 0 0}.live-pill{font-size:10px;color:var(--muted);white-space:nowrap}.live-pill i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#d6a45e;margin-right:5px}.live-pill.connected i{background:var(--green)}.tabs{display:flex;gap:7px;overflow-x:auto;padding:24px 0 16px}.tab{flex:none;border:1px solid var(--line);border-radius:30px;padding:9px 13px;background:transparent;color:var(--muted);font-size:11px;cursor:pointer}.tab.active{background:#ff6e9c20;border-color:#ff6e9c88;color:var(--pink2)}.prompt-card{min-height:260px;border-radius:18px;padding:22px;background:radial-gradient(circle at 90% 5%,#ff6e9c25,transparent 35%),linear-gradient(140deg,#382747,#2b203e);border:1px solid #ffffff12;display:flex;flex-direction:column;justify-content:space-between}.card-top{display:flex;justify-content:space-between;color:var(--pink2);font-size:10px;font-weight:700;letter-spacing:1.5px}.card-top span:last-child{font-size:20px}.prompt{font:600 clamp(23px,3vw,34px)/1.3 'Playfair Display',serif;max-width:560px;margin:25px 0}.turn-label{color:var(--muted);font-size:11px}.game-actions{display:flex;gap:10px;margin-top:15px}.game-actions .btn-primary{flex:1}.btn-quiet{background:#ffffff0b;color:var(--muted);border:1px solid var(--line)}.small-note{margin-top:14px}.side-area{display:flex;flex-direction:column;gap:13px}.voice-card{padding:22px}.avatars{display:flex;align-items:center;justify-content:space-between;padding:23px 0 18px}.person{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px}.person small{font-size:10px;color:var(--muted)}.avatar{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;font-size:25px;color:#4a1e39;background:linear-gradient(135deg,#ffb0c5,#ff6e9c);box-shadow:0 0 0 5px #ff6e9c18}.avatar.partner{background:linear-gradient(135deg,#d8b8ff,#9774cb);color:#2e1e48}.wave{color:var(--pink);font-size:28px}.voice-controls{display:grid;gap:8px}.control-btn{padding:11px;border:1px solid #ff6e9c55;background:#ff6e9c16;color:var(--pink2);border-radius:10px;font-size:11px;font-weight:700;cursor:pointer}.control-btn.danger{border-color:var(--line);background:#ffffff08;color:var(--muted)}.invite-card{display:flex;gap:13px;padding:17px;border-radius:16px;background:#ff6e9c12;border:1px solid #ff6e9c30}.invite-icon{font-size:24px}.invite-card strong{font-size:12px}.invite-card p{font-size:10px;line-height:1.5;color:var(--muted);margin:5px 0 0}.leave-btn{border:0;background:transparent;color:#b8adc8;font-size:11px;cursor:pointer;text-align:left;padding:8px 2px}footer{text-align:center;margin:auto 0 18px;padding:20px}footer span{color:var(--pink)}
@media(max-width:760px){.shell{width:min(100% - 24px,560px)}.topbar{height:65px}.top-note{font-size:10px}.welcome{margin:35px auto 25px;padding:34px 22px}.game-layout{grid-template-columns:1fr}.roombar{padding:14px 16px}.side-area{display:grid;grid-template-columns:1fr}.play-area{padding:19px}.prompt-card{min-height:230px}.game-heading{align-items:flex-start}.live-pill{padding-top:5px}}
@media(max-width:390px){.top-note{display:none}.feature-row{gap:12px}.tabs{margin-right:-5px}.game-actions{flex-direction:column}.game-actions .btn{width:100%}}
